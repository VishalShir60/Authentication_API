{
  "info": {
    "_postman_id": "auth-api-portfolio-collection",
    "name": "Authentication API",
    "description": "Postman collection covering all 5 endpoints of the Authentication API portfolio project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "verification_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fresher Dev\",\n  \"email\": \"dev@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Registers a new user, hashes password with bcrypt, generates verification token, and sends/logs verification email link."
      }
    },
    {
      "name": "2. Verify Email",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/verify/{{verification_token}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "verify", "{{verification_token}}"]
        },
        "description": "Verifies account by matching the random crypto token. Flips isVerified to true and clears the token."
      }
    },
    {
      "name": "3. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.token) {",
              "    pm.collectionVariables.set('auth_token', response.token);",
              "    console.log('Saved auth_token to collection variables');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"dev@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Authenticates verified user. Returns signed JWT token with 1-day expiry. The test script automatically saves auth_token."
      }
    },
    {
      "name": "4. Get Current User (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Protected route. authMiddleware reads Bearer token from header, validates JWT signature, loads user excluding password, and attaches to req.user."
      }
    },
    {
      "name": "5. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "logout"]
        },
        "description": "JWT is stateless. Client clears token from localStorage/cookies. Endpoint returns success confirmation."
      }
    }
  ]
}
